FROM golang:1.27-alpine3.22 AS builder

WORKDIR /app

COPY go.sum go.mod ./
RUN go mod download

COPY ./ ./

RUN CGO_ENABLED=0 go build -o /raftkv-cli ./cmd/raftkv-cli

FROM scratch
COPY --from=builder /raftkv-cli /raftkv-cli

ENTRYPOINT ["/raftkv-cli"]
CMD ["--addrs", "raftkv-0.raftkv-service:50051,raftkv-1.raftkv-service:50051,raftkv-2.raftkv-service:50051"]
